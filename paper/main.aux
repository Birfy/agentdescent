\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Rollout-dispatch throughput of the barrier-free runtime vs.\ worker count (fixed wall-clock window; \texttt  {examples/efficiency.py}). Near-linear to 8 workers --- the rollout stage holds no global lock. Across repeated runs the 8-worker figure landed between $7.8\times $ and $9.2\times $; the honest reading is ``linear to within measurement noise at this scale.''\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:scaling}{{2}{8}{Rollout-dispatch throughput of the barrier-free runtime vs.\ worker count (fixed wall-clock window; \code {examples/efficiency.py}). Near-linear to 8 workers --- the rollout stage holds no global lock. Across repeated runs the 8-worker figure landed between $7.8\times $ and $9.2\times $; the honest reading is ``linear to within measurement noise at this scale.''\relax }{figure.caption.6}{}}
\newlabel{fig:scaling@cref}{{[figure][2][]2}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effective concurrency (model-seconds $\div $ wall-clock) on a faithful GEPA port, HotpotQA, 16 rollouts pinned on every arm. The serial control is the published loop exactly (one worker, serial gate: overlap $1.00\times $). The round barrier is the whole difference between the parallel arms: the same four workers reach $1.85\times $ with it and $3.22\times $ without it. Wall-clock: 609\,s / 239\,s / 140\,s.\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:concurrency}{{3}{8}{Effective concurrency (model-seconds $\div $ wall-clock) on a faithful GEPA port, HotpotQA, 16 rollouts pinned on every arm. The serial control is the published loop exactly (one worker, serial gate: overlap $1.00\times $). The round barrier is the whole difference between the parallel arms: the same four workers reach $1.85\times $ with it and $3.22\times $ without it. Wall-clock: 609\,s / 239\,s / 140\,s.\relax }{figure.caption.6}{}}
\newlabel{fig:concurrency@cref}{{[figure][3][]3}{[1][8][]8}}
