\citation{fu2025areal}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces AgentDescent architecture. Evidence flows left to right: $N$ workers roll out tasks against ledger snapshots and emit diffs with evidence cards into a thread-safe buffer; a dedicated aggregator thread runs the five-stage merge pipeline and commits winners to the git-backed ledger. The green return path is the only feedback edge: workers refresh their snapshot from the ledger, and the lag budget \texttt  {async\_ratio} bounds how far behind head a snapshot may drift. In the synchronous runtime a round barrier sits between the two sides; in the barrier-free runtime they never wait for each other. Governance (dashed) forces high-blast-radius merges through an oracle and freezes the safety layer.\relax }}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:architecture}{{1}{4}{AgentDescent architecture. Evidence flows left to right: $N$ workers roll out tasks against ledger snapshots and emit diffs with evidence cards into a thread-safe buffer; a dedicated aggregator thread runs the five-stage merge pipeline and commits winners to the git-backed ledger. The green return path is the only feedback edge: workers refresh their snapshot from the ledger, and the lag budget \code {async\_ratio} bounds how far behind head a snapshot may drift. In the synchronous runtime a round barrier sits between the two sides; in the barrier-free runtime they never wait for each other. Governance (dashed) forces high-blast-radius merges through an oracle and freezes the safety layer.\relax }{figure.caption.5}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][3][]4}}
