      "code": "\"\"\"Stratified multi-start Hooke-Jeeves pattern search with call caching.\"\"\"\n\ndef search_algorithm(objective, budget, rng, bounds):\n    \"\"\"Return the best (x, y) found within a strict objective-call budget.\"\"\"\n    low, high = bounds\n    span = high - low\n\n    def clip(v):\n        return low if v < low else (high if v > high else v)\n\n    calls = 0\n    cache = {}\n    best_x = best_y = None\n    best_v = float('inf')\n\n    def evalf(x, y):\n        nonlocal calls\n        x = clip(x)\n        y = clip(y)\n        key = (round(x, 9), round(y, 9))\n        if key in cache:\n            return cache[key]\n        if calls >= budget:\n            return None\n        v = objective(x, y)\n        calls += 1\n        cache[key] = v\n        return v\n\n    # Phase 1: stratified jittered grid sampling to locate promising basins.\n    n = 6\n    stratum = span / n\n    samples = []\n    for i in range(n):\n        for j in range(n):\n            if calls >= budget:\n                break\n            x = low + (i + rng.random()) * stratum\n            y = low + (j + rng.random()) * stratum\n            v = evalf(x, y)\n            if v is None:\n                break\n            samples.append((v, x, y))\n        if calls >= budget:\n            break\n\n    samples.sort()\n    if samples:\n        best_v, best_x, best_y = samples[0]\n\n    # Phase 2: Hooke-Jeeves pattern search from the top few seeds.\n    n_starts = min(3, len(samples))\n    for s_idx in range(n_starts):\n        if calls >= budget:\n            break\n        x = samples[s_idx][1]\n        y = samples[s_idx][2]\n        v = evalf(x, y)\n        if v is None:\n            break\n        if v < best_v:\n            best_v, best_x, best_y = v, x, y\n        step = span / 4.0\n        step_min = 1e-3\n        prev_x, prev_y = x, y\n        while step > step_min and calls < budget:\n            improved = False\n            for dx, dy in ((step, 0.0), (-step, 0.0), (0.0, step), (0.0, -step)):\n                nx = clip(x + dx)\n                ny = clip(y + dy)\n                nv = evalf(nx, ny)\n                if nv is None:\n                    break\n                if nv < v:\n                    v = nv\n                    x, y = nx, ny\n                    improved = True\n            if v < best_v:\n                best_v, best_x, best_y = v, x, y\n            if not improved:\n                step *= 0.5\n            else:\n                px = clip(x + (x - prev_x))\n                py = clip(y + (y - prev_y))\n                pv = evalf(px, py)\n                if pv is not None and pv < v:\n                    x, y, v = px, py, pv\n                    if v < best_v:\n                        best_v, best_x, best_y = v, x, y\n                prev_x, prev_y = x, y\n\n    if best_x is None:\n        best_x = clip(rng.uniform(low, high))\n        best_y = clip(rng.uniform(low, high))\n    return best_x, best_y",
      "change_summary": "Replace pure random search with stratified jittered-grid seeding followed by multi-start Hooke-Jeeves pattern search with call caching to exploit smoothness and concentrate the budget on local refinement.",
